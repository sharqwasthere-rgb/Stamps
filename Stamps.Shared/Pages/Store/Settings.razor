@page "/Store/Settings"
@inject NavigationManager Navigation
@inject Stamps.Shared.Services.AuthStateService AuthState

<PageTitle>Impostazioni - Stamps</PageTitle>

<style>
    .settings-page {
        min-height: 100vh;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        padding: 20px;
        padding-bottom: 100px;
    }

    .back-btn {
        background: none;
        border: none;
        color: white;
        font-size: 1.5rem;
        cursor: pointer;
        margin-bottom: 20px;
    }

    .page-title {
        color: white;
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 30px;
    }

    .settings-card {
        background: rgba(255,255,255,0.1);
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 15px;
    }

    .settings-card h3 {
        color: #FFD700;
        font-size: 1.1rem;
        margin-bottom: 15px;
    }

    .setting-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px 0;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        color: white;
        cursor: pointer;
    }

    .setting-item:last-child {
        border-bottom: none;
    }

    .setting-label {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .setting-arrow {
        color: rgba(255,255,255,0.5);
    }

    .logout-btn {
        width: 100%;
        padding: 15px;
        background: #dc3545;
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        margin-top: 20px;
    }

    .user-info {
        background: rgba(255,255,255,0.1);
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 20px;
        color: white;
    }

    .user-info h3 {
        font-size: 1.2rem;
        margin-bottom: 5px;
    }

    .user-info p {
        color: rgba(255,255,255,0.7);
        font-size: 0.9rem;
    }

    .bottom-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: white;
        padding: 15px 20px;
        display: flex;
        justify-content: space-around;
        box-shadow: 0 -4px 20px rgba(0,0,0,0.1);
    }

    .nav-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: none;
        border: none;
        cursor: pointer;
        color: #666;
        font-size: 0.75rem;
    }

    .nav-item.active {
        color: #667eea;
    }

    .nav-item svg {
        width: 24px;
        height: 24px;
        margin-bottom: 5px;
    }
</style>

<div class="settings-page">
    <button class="back-btn" @onclick="GoBack">← Indietro</button>
    <h1 class="page-title">Impostazioni</h1>

    <div class="user-info">
        <h3>@(AuthState?.FullName ?? "Proprietario")</h3>
        <p>@(AuthState?.Email ?? "")</p>
        <p style="margin-top: 10px; font-size: 0.8rem;">Account Negozio</p>
    </div>

    <div class="settings-card">
        <h3>🏪 Negozio</h3>
        <div class="setting-item">
            <span class="setting-label">📝 Modifica Info Negozio</span>
            <span class="setting-arrow">›</span>
        </div>
        <div class="setting-item">
            <span class="setting-label">🎯 Configura Timbri Richiesti</span>
            <span class="setting-arrow">›</span>
        </div>
    </div>

    <div class="settings-card">
        <h3>⚙️ App</h3>
        <div class="setting-item">
            <span class="setting-label">🌐 Lingua</span>
            <span class="setting-arrow">Italiano ›</span>
        </div>
        <div class="setting-item">
            <span class="setting-label">🔔 Notifiche</span>
            <span class="setting-arrow">›</span>
        </div>
    </div>

    <div class="settings-card">
        <h3>ℹ️ Informazioni</h3>
        <div class="setting-item">
            <span class="setting-label">📄 Privacy Policy</span>
            <span class="setting-arrow">›</span>
        </div>
        <div class="setting-item">
            <span class="setting-label">📋 Termini di Servizio</span>
            <span class="setting-arrow">›</span>
        </div>
        <div class="setting-item">
            <span class="setting-label">📱 Versione App</span>
            <span class="setting-arrow">1.0.0</span>
        </div>
    </div>

    <button class="logout-btn" @onclick="Logout">Esci</button>
</div>

<div class="bottom-nav">
    <button class="nav-item" @onclick="GoToDashboard">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        Home
    </button>
    <button class="nav-item" @onclick="GoToStats">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="20" x2="18" y2="10"></line>
            <line x1="12" y1="20" x2="12" y2="4"></line>
            <line x1="6" y1="20" x2="6" y2="14"></line>
        </svg>
        Statistiche
    </button>
    <button class="nav-item active">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        Impostazioni
    </button>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthState?.LoadFromStorage();
        
        if (AuthState == null || !AuthState.IsLoggedIn || !AuthState.IsStoreOwner)
        {
            Navigation?.NavigateTo("/");
        }
    }

    private void GoBack() => Navigation?.NavigateTo("/Store/Dashboard");
    private void GoToDashboard() => Navigation?.NavigateTo("/Store/Dashboard");
    private void GoToStats() => Navigation?.NavigateTo("/Store/Stats");

    private void Logout()
    {
        AuthState?.Logout();
        Navigation?.NavigateTo("/");
    }
}

