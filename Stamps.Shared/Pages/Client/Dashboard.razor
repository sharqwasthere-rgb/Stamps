@page "/Client/Dashboard"
@inject NavigationManager Navigation
@inject HttpClient HttpClient
@inject Stamps.Shared.Services.AuthStateService AuthState

<PageTitle>Dashboard - Stamps</PageTitle>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        -webkit-tap-highlight-color: transparent;
    }

    .dashboard-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        position: relative;
        display: flex;
        flex-direction: column;
        padding-bottom: 120px;
    }

    /* Header */
    .header {
        padding: 30px 20px 20px;
        color: white;
    }

    .greeting-text {
        font-size: 1.8rem;
        font-weight: 700;
    }

    .subtitle {
        color: rgba(255,255,255,0.8);
        margin-top: 5px;
    }

    /* Stamp Cards Carousel */
    .cards-section {
        padding: 0 20px;
        flex: 1;
    }

    .cards-title {
        color: white;
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .cards-carousel {
        display: flex;
        gap: 15px;
        overflow-x: auto;
        padding-bottom: 15px;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
    }

    .cards-carousel::-webkit-scrollbar {
        display: none;
    }

    .stamp-card {
        min-width: 280px;
        background: white;
        border-radius: 20px;
        padding: 20px;
        scroll-snap-align: start;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        transition: transform 0.3s;
    }

    .stamp-card.complete {
        background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
        animation: glow 2s ease-in-out infinite;
    }

    @@keyframes glow {
        0%, 100% { box-shadow: 0 10px 30px rgba(255,215,0,0.4); }
        50% { box-shadow: 0 10px 50px rgba(255,215,0,0.8); }
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 15px;
    }

    .store-name {
        font-size: 1.2rem;
        font-weight: 700;
        color: #333;
    }

    .stamp-card.complete .store-name {
        color: #333;
    }

    .complete-badge {
        background: #28a745;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .stamps-display {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 15px;
    }

    .stamp-dot {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        border: 2px solid #ddd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .stamp-dot.filled {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-color: #667eea;
        color: white;
    }

    .stamp-card.complete .stamp-dot.filled {
        background: #333;
        border-color: #333;
    }

    .card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #666;
        font-size: 0.85rem;
    }

    .stamp-card.complete .card-footer {
        color: #333;
    }

    .redeem-btn {
        background: #333;
        color: #FFD700;
        border: none;
        padding: 10px 20px;
        border-radius: 25px;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s;
    }

    .redeem-btn:active {
        transform: scale(0.95);
    }

    /* Empty State */
    .empty-cards {
        background: rgba(255,255,255,0.1);
        border-radius: 20px;
        padding: 40px 20px;
        text-align: center;
        color: white;
    }

    .empty-cards p {
        margin-top: 10px;
        color: rgba(255,255,255,0.7);
    }

    /* Bottom Navigation */
    .bottom-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: white;
        padding: 20px;
        padding-bottom: calc(20px + env(safe-area-inset-bottom, 20px));
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 -4px 20px rgba(0,0,0,0.1);
        z-index: 100;
    }

    .nav-button {
        width: 60px;
        height: 60px;
        border-radius: 15px;
        border: none;
        background: #f5f5f5;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .nav-button:active {
        transform: scale(0.9);
    }

    .qr-button {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        border: none;
        background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 20px rgba(255,215,0,0.4);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .qr-button:active {
        transform: scale(0.9);
    }

    /* QR Code Overlay */
    .qr-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.9);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
        padding: 20px;
    }

    .qr-overlay.show {
        opacity: 1;
        pointer-events: all;
    }

    .qr-container {
        background: white;
        padding: 25px;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.3);
        transform: scale(0.8);
        transition: transform 0.3s ease;
        width: 90%;
        max-width: 400px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .qr-overlay.show .qr-container {
        transform: scale(1);
    }

    .qr-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #333;
        margin-bottom: 20px;
        text-align: center;
    }

    .qr-subtitle {
        color: #666;
        font-size: 0.9rem;
        text-align: center;
        margin-top: 15px;
    }

    .close-qr-button {
        margin-top: 20px;
        background: #667eea;
        color: white;
        border: none;
        padding: 15px 40px;
        border-radius: 50px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
    }

    /* Notification Toast */
    .toast {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%) translateY(-100px);
        background: #28a745;
        color: white;
        padding: 15px 25px;
        border-radius: 10px;
        font-weight: 600;
        z-index: 2000;
        transition: transform 0.3s;
        box-shadow: 0 5px 20px rgba(0,0,0,0.2);
    }

    .toast.show {
        transform: translateX(-50%) translateY(0);
    }

    .loading {
        color: white;
        text-align: center;
        padding: 20px;
    }

    @@media (max-width: 768px) {
        .stamp-card {
            min-width: 260px;
        }

        .nav-button {
            width: 50px;
            height: 50px;
        }

        .qr-button {
            width: 70px;
            height: 70px;
        }
    }
</style>

<div class="dashboard-container">
    <div class="header">
        <h1 class="greeting-text">Ciao, @(userName ?? "Utente")!</h1>
        <p class="subtitle">@stampCards.Count carte fedeltà</p>
    </div>

    <div class="cards-section">
        <div class="cards-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                <line x1="1" y1="10" x2="23" y2="10"></line>
            </svg>
            Le tue Carte
        </div>

        @if (isLoading)
        {
            <div class="loading">Caricamento carte...</div>
        }
        else if (stampCards.Count == 0)
        {
            <div class="empty-cards">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                    <line x1="1" y1="10" x2="23" y2="10"></line>
                </svg>
                <p>Nessuna carta fedeltà ancora.<br/>Visita un negozio per iniziare!</p>
            </div>
        }
        else
        {
            <div class="cards-carousel">
                @foreach (var card in stampCards)
                {
                    <div class="stamp-card @(card.IsComplete ? "complete" : "")">
                        <div class="card-header">
                            <span class="store-name">@card.StoreName</span>
                            @if (card.IsComplete)
                            {
                                <span class="complete-badge">COMPLETA!</span>
                            }
                        </div>
                        <div class="stamps-display">
                            @for (int i = 1; i <= card.RequiredStamps; i++)
                            {
                                <div class="stamp-dot @(i <= card.CurrentStamps ? "filled" : "")">
                                    @if (i <= card.CurrentStamps)
                                    {
                                        <span>✓</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="card-footer">
                            <span>@card.CurrentStamps / @card.RequiredStamps timbri</span>
                            @if (card.IsComplete)
                            {
                                <button class="redeem-btn" @onclick="() => ShowRedemptionQR(card)">
                                    Riscatta Premio
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Bottom Navigation -->
    <div class="bottom-nav">
        <button class="nav-button" @onclick="GoToProfile">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
            </svg>
        </button>

        <button class="qr-button" @onclick="ToggleQRCode">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
        </button>

        <button class="nav-button" @onclick="GoToMap">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
            </svg>
        </button>
    </div>

    <!-- QR Code Overlay -->
    <div class="qr-overlay @(showQRCode ? "show" : "")" @onclick="CloseQRCode">
        <div class="qr-container" @onclick:stopPropagation>
            <h2 class="qr-title">@qrTitle</h2>
            @if (isLoadingQR)
            {
                <div style="padding: 50px; color: #666;">Caricamento...</div>
            }
            else if (!string.IsNullOrEmpty(qrCodeImage))
            {
                <img src="@qrCodeImage" alt="QR Code" style="width: 100%; max-width: 280px; height: auto; border-radius: 10px;" />
                <p class="qr-subtitle">@qrSubtitle</p>
                <p style="margin-top: 15px; font-size: 0.75rem; color: #999; word-break: break-all; text-align: center;">
                    ID: @(AuthState?.UserId ?? "")
                </p>
            }
            else
            {
                <div style="padding: 50px; color: #c33;">Errore nel caricamento</div>
            }
            <button class="close-qr-button" @onclick="CloseQRCode">Chiudi</button>
        </div>
    </div>

    <!-- Toast Notification -->
    <div class="toast @(showToast ? "show" : "")">
        @toastMessage
    </div>
</div>

@code {
    private List<StampCardDto> stampCards = new();
    private bool isLoading = true;
    private bool isLoadingQR = false;
    private bool showQRCode = false;
    private string? qrCodeImage;
    private string? userName;
    private string qrTitle = "Il tuo QR Code";
    private string qrSubtitle = "Mostra questo QR al negoziante per ricevere punti";
    
    private bool showToast = false;
    private string toastMessage = "";
    private DateTime lastPollTime = DateTime.UtcNow;
    private System.Threading.Timer? pollTimer;

    protected override async Task OnInitializedAsync()
    {
        AuthState?.LoadFromStorage();
        
        if (AuthState == null || !AuthState.IsLoggedIn)
        {
            Navigation?.NavigateTo("/");
            return;
        }
        
        userName = AuthState.FullName;
        await LoadStampCards();
        await LoadQRCode();
        
        // Start polling for updates every 5 seconds
        pollTimer = new System.Threading.Timer(async _ => await PollForUpdates(), null, 5000, 5000);
    }

    private async Task LoadStampCards()
    {
        try
        {
            var response = await HttpClient.GetAsync($"https://stamps-ecxm.onrender.com/api/stampcards/user/{AuthState?.UserId}");
            if (response.IsSuccessStatusCode)
            {
                stampCards = await response.Content.ReadFromJsonAsync<List<StampCardDto>>() ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading stamp cards: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadQRCode()
    {
        if (HttpClient == null) return;

        try
        {
            var response = await HttpClient.GetFromJsonAsync<QRCodeResponse>(
                $"https://stamps-ecxm.onrender.com/api/qrcode/user/{AuthState?.UserId}"
            );
            
            if (response != null)
            {
                qrCodeImage = response.QrImage;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading QR code: {ex.Message}");
        }
    }

    private async Task PollForUpdates()
    {
        try
        {
            var response = await HttpClient.GetAsync(
                $"https://stamps-ecxm.onrender.com/api/stampcards/user/{AuthState?.UserId}/recent?since={lastPollTime:o}"
            );
            
            if (response.IsSuccessStatusCode)
            {
                var updates = await response.Content.ReadFromJsonAsync<List<RecentUpdateDto>>();
                if (updates != null && updates.Count > 0)
                {
                    lastPollTime = DateTime.UtcNow;
                    
                    // Show notification for new stamps
                    var latestUpdate = updates.First();
                    if (latestUpdate.Type == "StampAdded")
                    {
                        await ShowToast($"🎉 +{latestUpdate.StampsAdded} timbro da {latestUpdate.StoreName}!");
                    }
                    else if (latestUpdate.Type == "Redemption")
                    {
                        await ShowToast($"✓ Premio riscattato da {latestUpdate.StoreName}!");
                    }
                    
                    // Reload cards
                    await InvokeAsync(async () =>
                    {
                        await LoadStampCards();
                        StateHasChanged();
                    });
                }
            }
        }
        catch
        {
            // Silently fail polling
        }
    }

    private async Task ShowToast(string message)
    {
        toastMessage = message;
        showToast = true;
        await InvokeAsync(StateHasChanged);
        
        await Task.Delay(3000);
        showToast = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleQRCode()
    {
        qrTitle = "Il tuo QR Code";
        qrSubtitle = "Mostra questo QR al negoziante per ricevere punti";
        
        if (!showQRCode && string.IsNullOrEmpty(qrCodeImage))
        {
            isLoadingQR = true;
            showQRCode = true;
            StateHasChanged();
            
            await LoadQRCode();
            
            isLoadingQR = false;
            StateHasChanged();
        }
        else
        {
            showQRCode = !showQRCode;
        }
    }

    private async Task ShowRedemptionQR(StampCardDto card)
    {
        isLoadingQR = true;
        showQRCode = true;
        qrTitle = "Riscatta Premio";
        qrSubtitle = $"Mostra al negoziante di {card.StoreName}";
        qrCodeImage = null;
        StateHasChanged();

        try
        {
            var response = await HttpClient.GetAsync(
                $"https://byssal-janene-lyingly.ngrok-free.dev/api/stampcards/{card.Id}/redemption-qr?userId={AuthState?.UserId}"
            );
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<RedemptionQRResponse>();
                qrCodeImage = result?.QrImage;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading redemption QR: {ex.Message}");
        }
        finally
        {
            isLoadingQR = false;
            StateHasChanged();
        }
    }

    private void CloseQRCode()
    {
        showQRCode = false;
    }

    private void GoToProfile()
    {
        Navigation?.NavigateTo("/Client/Profile");
    }

    private void GoToMap()
    {
        Navigation?.NavigateTo("/Client/Map");
    }

    public void Dispose()
    {
        pollTimer?.Dispose();
    }

    private class StampCardDto
    {
        public int Id { get; set; }
        public int StoreId { get; set; }
        public string StoreName { get; set; } = "";
        public string StoreAddress { get; set; } = "";
        public int CurrentStamps { get; set; }
        public int RequiredStamps { get; set; }
        public bool IsComplete { get; set; }
        public DateTime LastUpdated { get; set; }
    }

    private class QRCodeResponse
    {
        public string UserId { get; set; } = "";
        public string UserName { get; set; } = "";
        public string QrData { get; set; } = "";
        public string QrImage { get; set; } = "";
    }

    private class RecentUpdateDto
    {
        public int TransactionId { get; set; }
        public int StampCardId { get; set; }
        public string StoreName { get; set; } = "";
        public int StampsAdded { get; set; }
        public int StampsRedeemed { get; set; }
        public string Type { get; set; } = "";
        public int CurrentStamps { get; set; }
        public int RequiredStamps { get; set; }
        public bool IsComplete { get; set; }
        public DateTime Timestamp { get; set; }
    }

    private class RedemptionQRResponse
    {
        public int CardId { get; set; }
        public string StoreName { get; set; } = "";
        public int StampsToRedeem { get; set; }
        public string QrData { get; set; } = "";
        public string QrImage { get; set; } = "";
    }
}
